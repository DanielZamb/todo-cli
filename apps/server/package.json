{
  "name": "@todo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun --bun ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "start": "bun src/main.ts",
    "build": "bun ../../scripts/compile.ts src/main.ts dist/todo-server"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@todo/api": "workspace:*",
    "@todo/domain": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/bun": "1.4.3",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
